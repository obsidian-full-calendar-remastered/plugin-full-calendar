{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"strict": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"importHelpers": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"lib": [
			"DOM",
			"ES5",
			"ES6",
			"ES7",
			"ES2022"
		],
		"jsx": "react-jsx",
		"rootDir": "."
	},
	"include": [
		"**/*.d.ts",
		"**/*.ts",
		"**/*.tsx"
	]
}